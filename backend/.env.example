# Campus Connect Backend Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/campus_connect

# Authentication & Sessions
JWT_SECRET=dev_jwt_secret_change_in_production_campus_connect
JWT_EXPIRES_IN=1d
COOKIE_NAME=campus_connect_token
COOKIE_SECURE=false

# Password Reset URL (Frontend route)
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Email / SMTP Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Campus Connect <no-reply@campusconnect.edu>"

# Cloudinary (Milestone 3+ Image Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
